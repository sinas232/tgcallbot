+        attempts = max(1, int(getattr(Config, "VOICE_ENGINE_START_ATTEMPTS", 3)))
+        timeout = max(5, int(getattr(Config, "VOICE_ENGINE_START_TIMEOUT", 15)))
+        last_exc: Optional[BaseException] = None

+            cores = detect_cpu_cores()
+            usage = read_cpu_usage_usec()
+        except Exception as exc:            # pragma: no cover - would be a bug
+            self.fail(f"live cgroup read raised {exc!r}")
+        self.assertGreaterEqual(cores, 1.0)

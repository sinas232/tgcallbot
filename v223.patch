+def _naive_utc_from_epoch(epoch_seconds: int) -> datetime:
+    """epoch ثانیه → datetime naive-UTC (بدون وابستگی به TZ محیط)."""
+    return _EPOCH + timedelta(seconds=int(epoch_seconds))

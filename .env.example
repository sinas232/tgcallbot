# ═══════════════════════════════════════════════════
# نمونهٔ فایل تنظیمات — این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید:
#   cp .env.example .env
# ⚠️ فایل .env هرگز نباید در گیت commit شود (در .gitignore هست).
# ═══════════════════════════════════════════════════


# ═══════════════════════════════════════════════════
# Telegram API Credentials  (از my.telegram.org و BotFather)
# ═══════════════════════════════════════════════════
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
BOT_TOKEN=


# ═══════════════════════════════════════════════════
# Database Configuration (Docker Network)
# ═══════════════════════════════════════════════════
DATABASE_URL=postgresql://username:password@db:5432/dbname
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname


# ═══════════════════════════════════════════════════
# Redis Cache (Docker Network)
# ═══════════════════════════════════════════════════
REDIS_URL=redis://redis:6379/0


# ═══════════════════════════════════════════════════
# Admin & Security
# ═══════════════════════════════════════════════════
# آیدی عددی ادمین‌ها، با کاما جدا شود
ADMIN_IDS=
# کلید رمزنگاری سشن‌ها (Fernet). برای ساخت:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
# حداقل فاصلهٔ اتصال دوباره با همان auth key پس از قطع موفق؛ حداقل مجاز ۵ ثانیه است.
SESSION_RECONNECT_QUIET_SEC=5
# محافظت سشن اجباری است؛ VOICE_SESSION_OWNERSHIP=false دیگر غیرفعالش نمی‌کند.


# ═══════════════════════════════════════════════════
# Web Server & Payment Gateway
# ═══════════════════════════════════════════════════
# ⚠️ آدرس عمومیِ callback درگاه پرداخت — باید به سرور خودتان اشاره کند و از
# اینترنت قابل‌دسترس باشد. راهنمای کامل: docs/payment-gateway.fa.md
#
# نکته: این با «زیردامنهٔ اختصاصی زرین‌پال» (CNAME→zpc.zarinpal.com) فرق دارد!
# آن به سرور زرین‌پال می‌رود؛ این باید به سرور خودتان (رکورد A) اشاره کند.
#
# کانتینر nginx (webproxy) درخواست‌ها را روی پورت 80 می‌گیرد و داخلی به
# وب‌سرور می‌رساند؛ پس SERVER_URL بدون :8080 و روی پورت استاندارد 80 است.
#   بدون HTTPS (پورت 80):   SERVER_URL=http://bot.example.com
#   با HTTPS (توصیه‌شده):    SERVER_URL=https://bot.example.com  (نیاز به گواهی روی nginx)
SERVER_URL=http://bot.example.com
# PORT پورت داخلیِ وب‌سرور است (nginx به آن پاس می‌دهد)؛ روی 8080 بماند.
PORT=8080

# شناسهٔ پذیرندهٔ زرین‌پال (بدون آن لینک پرداخت ساخته نمی‌شود)
ZARINPAL_MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# درگاه آقای پرداخت (در صورت استفاده)
AQAYE_PARDAKHT_PIN=sandbox

# پروکسی درخواست‌های درگاه پرداخت (بدون WARP).
# چون ربات با WARP اجرا می‌شود و درگاه‌های ایرانی اتصال از IP خارجی را رد
# می‌کنند، درخواست ساخت/تأیید پرداخت باید از یک پروکسیِ بدون WARP (کانتینر
# payproxy روی IP ایرانیِ هاست) عبور کند. پیش‌فرضِ docker-compose درست است؛
# فقط اگر خواستید غیرفعالش کنید خالی بگذارید (آنگاه از WARP می‌رود و timeout).
PAYMENT_HTTP_PROXY=http://payproxy:8888


# ═══════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════
MAX_ACCOUNTS_PER_USER=1000
RATE_LIMIT_PER_MINUTE=30
# سقف سراسری سفارش‌های running/pending؛ رزروهای scheduled هنگام سررسید
# فقط با وجود جای خالی شروع می‌شوند. 0 = بدون سقف؛ اندازهٔ پلن را کم نمی‌کند.
MAX_CONCURRENT_ORDERS=10
# any = متن/لینک عمومی هم قابل ثبت است (رفتار موجود)، private = فقط دعوت خصوصی.
ORDER_LINK_MODE=any
# محدودیت قالب اختیاری (fullmatch)، نمونهٔ راهنما (در صورت نیاز):
ORDER_LINK_REGEX=
ORDER_LINK_EXAMPLE=
# ── سقف منابع کانتینرها ─────────────────────────────────────────────────
# این‌ها سقف‌اند نه رزرو. پیش‌فرض‌ها برای هاست ۱۶ گیگ / ۸ هسته تنظیم شده‌اند
# (جمعاً ۸.۵ گیگ، باقی برای warp/proxy‌ها/سیستم‌عامل).
# حتماً بعد از استقرار با docker inspect تأیید کنید — مقدار در .env به تنهایی
# ثابت نمی‌کند کانتینر با آن recreate شده است.
BOT_MEM_LIMIT=6G
BOT_CPU_LIMIT=8.0
# بدون سقف روی db/redis، رشد هرکدام OOM-killer را سراغ بزرگ‌ترین پروسه
# می‌فرستد — که bot است.
DB_MEM_LIMIT=2G
DB_CPU_LIMIT=1.0
REDIS_MEM_LIMIT=512M
REDIS_CPU_LIMIT=0.5
HEALTH_CHECK_INTERVAL=3600
LOG_LEVEL=INFO


# ═══════════════════════════════════════════════════
# Voice Call Settings
# ═══════════════════════════════════════════════════
# این خانواده‌ها در نسخهٔ جدید خوانده می‌شوند؛ سازگاریِ مقادیر در
# tools/validate_env_compat.py و عملکردشان در تست‌های آفلاین پوشش داده شده،
# اما صحت تماس زنده/سشن‌های سرور را باید جداگانه بررسی کرد.
JOIN_DELAY_SECONDS=3.0
ACCOUNT_LOCK_TIMEOUT=120
OPERATION_TIMEOUT=90
KEEPALIVE_INTERVAL=20
MAX_JOIN_RETRIES=3
RETRY_BACKOFF_BASE=2.0
# صدای استریم سکوت (بهینه‌شده برای CPU): مونو ۲۴kHz
VOICE_AUDIO_SAMPLE_RATE=24000
VOICE_AUDIO_CHANNELS=1

# false = موج تطبیقی قبلی؛ true = تنها یک join در هر سفارش (همراه ریکاوری).
# حداقل فاصلهٔ شروع بعد از پایان اکانت قبلی؛ پروفایل ضداسپمِ پنل اگر کندتر
# باشد اولویت دارد. نام‌های VOICE_JOIN_SEQUENTIAL_GAP_MIN/MAX نیز پذیرفته‌اند.
VOICE_JOIN_SEQUENTIAL=false
VOICE_JOIN_ACCOUNT_GAP_MIN=1.0
VOICE_JOIN_ACCOUNT_GAP_MAX=2.0
VOICE_JOIN_ACCOUNT_GAP_JITTER_MIN=0.0
VOICE_JOIN_ACCOUNT_GAP_JITTER_MAX=0.5
# پیش‌گرم‌سازیِ کلاینت بعدی (اتصال همان کلید هرگز هم‌زمان دوباره باز نمی‌شود):
VOICE_JOIN_SEQUENTIAL_PREWARM=false
# هر دور فقط یک تلاش تازه برای خطای گذرا؛ 406/401/کلید تعویض‌شده ممنوع.
# تلاش 0 قدیمی به 1 در هر دور نگاشت می‌شود، بی‌نهایت نیست.
VOICE_ACCOUNT_ATTEMPT_LIMIT=2
VOICE_SECOND_CHANCE_ROUNDS=0
VOICE_SECOND_CHANCE_COOLDOWN_SECONDS=60
# ── خطاهای سمت تلگرام (زیرساخت) ──
# خطای ۵۰۰ تلگرام (INTERDC_X_CALL_ERROR / INTERNAL_SERVER_ERROR)، تایم‌اوت
# ترابری یا «join بدون پاسخ» تقصیر اکانت نیست: بودجهٔ تلاش اکانت خورده نمی‌شود،
# بن نمی‌شود و فقط بعد از این مکث کوتاه دوباره امتحان می‌شود.
VOICE_SYSTEM_FAILURE_PAUSE_SECONDS=15
# اگر یک موج کامل به‌خاطر خطای سمت تلگرام شکست بخورد، موج‌های بعدی این‌قدر
# مکث می‌کنند (به‌جای باریک‌کردن پنجره؛ چون اکانت‌ها سالم‌اند).
VOICE_SYSTEM_PAUSE_SECONDS=20
# سقف دورهای انتظارِ بی‌پیشرفت در فاز ساخت؛ بعد از آن ساخت با گزارش صریح
# کسری جاها تمام می‌شود تا سفارش بی‌نهایت معطل نماند.
VOICE_BUILD_MAX_STALL_ROUNDS=20
# ── گاردِ آپدیتِ Pyrogram (طوفان 500 PERSISTENT_TIMESTAMP_OUTDATED) ──
# کلاینت ویس باید no_updates=False باشد (PyTgCalls رویدادهای کال را از همان
# dispatcher می‌گیرد). برای حلِ min-peerها خودِ Pyrogram متد
# updates.GetChannelDifference را صدا می‌زند و تلگرام در گروه شلوغ به آن
# «500 PERSISTENT_TIMESTAMP_OUTDATED» می‌دهد. کتابخانه این ۵۰۰ را ۱۰ بار با
# تأخیر ۱s تکرار می‌کرد (۱۰ خط WARNING در ثانیه برای هر اکانت) و در پایان یک
# TimeoutError می‌ساخت که handle_updates نمی‌گیرد ⇒ بقیهٔ آپدیت‌های همان بسته
# (رویدادهای ویس‌کال/شرکت‌کننده‌ها) بی‌صدا دور ریخته می‌شدند: آمار live کهنه،
# از دست رفتن LEFT_CALL/CALL_ENDED. گارد همان فراخوانی را سریع‌شکست می‌کند و
# خطایی می‌دهد که خودِ کتابخانه نادیده می‌گیرد، پس بستهٔ آپدیت زنده می‌ماند.
# false ⇒ رفتارِ اصلیِ کتابخانه (۱۰ تلاش + TimeoutError).
PYROGRAM_UPDATES_GUARD=true
PYROGRAM_UPDATES_DIFF_ATTEMPTS=2
# پنجرهٔ خلاصه‌سازیِ هشدارهای یک‌شکلِ پیاپیِ کتابخانه در کنسول (ثانیه): خطِ
# اول همیشه چاپ می‌شود و خطِ بعدی تعدادِ خط‌های جمع‌شده را می‌گوید.
PYROGRAM_LOG_DEDUPE_WINDOW=30
# ── بالاآمدن انجین (PyTgCalls.start) ──
# یک تایم‌اوت ۱۵ ثانیه‌ای دیگر اکانت را برای همیشهٔ پروسه قرنطینه نمی‌کند؛
# همان هندل انجین دوباره تلاش می‌شود (انجین دوم ساخته نمی‌شود).
VOICE_ENGINE_START_ATTEMPTS=3
VOICE_ENGINE_START_TIMEOUT=15
# ── تأیید حضور ──
# اسنپ‌شات اشتراکیِ لیست شرکت‌کنندگان در ویس‌کال‌های بزرگ ناقص می‌شود؛ «غایب»
# فقط بعد از یک بررسیِ مستقیمِ همان اکانت به قطع‌شدن/ری‌جوین تبدیل می‌شود.
VOICE_PRESENCE_DIRECT_RECHECK=true
# اگر خودِ ویس‌چت از سمت تلگرام بسته شود، همهٔ اکانت‌ها بیرون می‌افتند و هر
# تلاش ری‌جوین/بازسازی مدیا فقط «Call ... already removed» تولید می‌کند. یک
# آپدیت تنها کافی نیست: چت وقتی «بسته» علامت می‌خورد که این تعداد اکانتِ همان
# سفارش در این بازهٔ ثانیه‌ای تأییدش کنند، و تا این مدت ثانیه‌ای تلاش بی‌فایده
# متوقف می‌شود (یک join موفق فوراً پاکش می‌کند).
VOICE_CHAT_CLOSED_MIN_ACCOUNTS=2
VOICE_CHAT_CLOSED_WINDOW_SECONDS=60
VOICE_CHAT_CLOSED_GRACE_SECONDS=300
# بعد از پاسخ «ادامه می‌دهم»، اگر کال تا این مدت تازه نشود، سفارش خودکار
# تسویه می‌شود و مبلغ زمانِ سرویس‌نشده به کیف پول برمی‌گردد (۰ = خاموش).
VOICE_CHAT_CLOSED_CONTINUE_GRACE_SECONDS=600
# media = استریم سکوت فعلی؛ auto = یک شنوندهٔ آزمایشی در هر چت تا تأیید
# دوگانهٔ حضور و binding؛ خطا/قطع => بازگشت به استریم؛ listener = opt-in صریح.
VOICE_SILENCE_MODE=media
VOICE_LISTENER_PROBE_SECONDS=60
VOICE_LISTENER_MAX_FAILURES=2
VOICE_LISTENER_MAX_DROPS=3
# پس از 406، کلید از سفارش‌های بعدی کنار می‌ماند؛ فقط از کارت همان اکانت
# (در پردازهٔ خود ربات) پس از این مکث بررسی/رفع قرنطینه می‌شود؛ خودکار retry نشود.
VOICE_SESSION_CONFLICT_RETRY_SECONDS=60
# کلاینت‌های بدون سفارش و بدون binding پس از TTL قطع می‌شوند؛ تماس فعال نه.
VOICE_IDLE_REAPER=true
VOICE_IDLE_CLIENT_TTL=300
VOICE_IDLE_SWEEP_INTERVAL=60
VOICE_MEMORY_LOG_INTERVAL=600
# هشدار حافظه + جمع‌آوری فقط کلاینت‌های بیکار (0 = خاموش؛ OOM فعال را درمان نمی‌کند).
VOICE_RAM_SOFT_LIMIT_MB=0


# ═══════════════════════════════════════════════════
# In-Call Chat (پیام/ری‌اکشن مشتری داخل ویس‌کال)
# ═══════════════════════════════════════════════════
# قابلیتِ ارسال کامنت/ری‌اکشن از چند اکانت درون تماس (نیازمند kurigram که در
# requirements.txt هست). روشن/خاموش کردن این قابلیت از پنل ادمین انجام می‌شود
# (کلید تنظیم: service_incall_chat) و نیازی به متغیر env ندارد.
#
# pacing ضدِ burst: وقتی مشتری از چند اکانت هم‌زمان پیام/ری‌اکشن می‌فرستد،
# درخواست‌ها یک‌جا شلیک نمی‌شوند (که باعث FloodWait و دیده‌نشدن پیام می‌شد)،
# بلکه با فاصلهٔ منظم (~۱ درخواست در ثانیه) و سقف هم‌زمانی محدود ارسال می‌گردند.
# اگر تلگرام FloodWait داد این دو را بزرگ‌تر کنید؛ برای سریع‌تر شدن کوچک‌تر.
INCALL_SEND_STAGGER_MIN=0.8
INCALL_SEND_STAGGER_MAX=1.2
# بیشترین تعداد ارسالِ هم‌زمانِ در حال پرواز (سقف concurrency).
INCALL_SEND_MAX_CONCURRENCY=3

# ── خروج مدیریت‌شده بعد از پایان/لغو سفارش (ضد burst) ──
# اکانت‌ها نباید یک‌جا از ویس‌کال/گروه خارج شوند (ریسک FloodWait و محدودیت).
# فاصله بین شروع هر leave (ثانیه) + سقف هم‌زمانی LeaveGroupCall/leave_chat.
VOICE_LEAVE_STAGGER_MIN=0.8
VOICE_LEAVE_STAGGER_MAX=1.5
VOICE_LEAVE_MAX_CONCURRENCY=2
VOICE_LEAVE_JITTER_MIN=0.0
VOICE_LEAVE_JITTER_MAX=0.4


# ═══════════════════════════════════════════════════
# Delays
# ═══════════════════════════════════════════════════
DELAY_MIN=5


# ═══════════════════════════════════════════════════
# Proxy (SOCKS5 از کانتینر WARP)
# در حالت network_mode: service:warp، پروکسی روی 127.0.0.1:1080 است.
# ═══════════════════════════════════════════════════
USE_PROXY=true
SOCKS5_HOST=127.0.0.1
SOCKS5_PORT=1080
# SOCKS5_USERNAME=
# SOCKS5_PASSWORD=


# ═══════════════════════════════════════════════════
# ایموجی پریمیوم (Custom Emoji) — نیازمند Telegram Premium
# روی اکانتِ «مالکِ ربات» (سازندهٔ ربات در BotFather)
# ═══════════════════════════════════════════════════
# از Bot API 9.4 (۹ فوریهٔ ۲۰۲۶) اگر مالکِ ربات اشتراک پریمیوم داشته باشد،
# ربات می‌تواند در متن پیام‌ها ایموجی سفارشی بفرستد و روی دکمه‌ها
# «آیکون پریمیوم» بگذارد. راهنمای کامل: docs/premium-emoji.fa.md
#
# همهٔ این کلیدها از پنل ادمین → «⚙️ تنظیمات سیستم» → «💎 ایموجی پریمیوم»
# هم قابل تغییرند (تنظیمات پنل بر .env اولویت دارد و در دیتابیس ذخیره می‌شود).
PREMIUM_EMOJI_ENABLED=true
# ایموجی پریمیوم داخل متن پیام‌ها (منوها، گزارش‌ها، پاسخ‌ها، پیام همگانی)
PREMIUM_EMOJI_TEXT=true
# آیکون پریمیوم روی دکمه‌های inline
PREMIUM_EMOJI_BUTTONS=true
# آیکون پریمیوم روی دکمه‌های کیبورد اصلی (reply keyboard)
PREMIUM_EMOJI_REPLY_BUTTONS=true
# ایموجیِ انتهای متن دکمه هم به آیکون تبدیل شود («عضو شدم ✅» → [✅] عضو شدم)
PREMIUM_EMOJI_TRAILING_ICONS=true
# پیام‌های Markdown قدیمی به HTML تبدیل شوند تا ایموجی پریمیوم بگیرند
PREMIUM_EMOJI_MARKDOWN_TO_HTML=true
# اعتبارسنجی شناسه‌ها در استارت (شناسهٔ نامعتبر خودکار حذف می‌شود)
PREMIUM_EMOJI_VALIDATE=true
# در کانال‌ها ایموجی سفارشی مجاز نیست؛ بدون تلاش رد شود
PREMIUM_EMOJI_SKIP_CHANNELS=true
# سقف ایموجی در هر پیام (تلگرام حداکثر ۱۰۰ entity می‌پذیرد)
PREMIUM_EMOJI_MAX_PER_MESSAGE=90

# اگر true باشد، شناسه‌ای که ایموجی واقعی‌اش با ایموجی مورد انتظار بسته فرق
# دارد هم غیرفعال می‌شود (پیش‌فرض false = فقط گزارش در لاگ و پنل ادمین).
PREMIUM_EMOJI_STRICT_MATCH=false
# رنگ‌آمیزی خودکار دکمه‌ها (سبز=تایید/پرداخت، قرمز=حذف/انصراف، آبی=بازگشت/اصلی)
# مبتنی بر Bot API 9.4 — روی همهٔ دکمه‌های inline و reply اعمال می‌شود.
PREMIUM_EMOJI_COLORED_BUTTONS=true
# جایگزینی شناسهٔ ایموجی دلخواه (JSON یا key=id,key=id):
# PREMIUM_EMOJI_OVERRIDES={"rocket":"5389102131527556772"}
PREMIUM_EMOJI_OVERRIDES=
# ═══════════════ 🛡 حالت ضد اسپم و محافظت اکانت‌ها (Anti-Spam) ═══════════════
# توجه: همهٔ این مقادیر فقط «پیش‌فرض fallback» هستند. مقدار نهایی از پنل
# سوپرادمین → «🛡 ضد اسپم و محافظت» خوانده می‌شود و بدون ری‌استارت اعمال می‌گردد.

# سوییچ کلی حالت ضد اسپم (join آهسته‌تر + خروج انسانی‌تر + استراحت اکانت):
ANTISPAM_ENABLED=true
# فاصلهٔ شروع join دو اکانت متوالی (ثانیه) در حالت محافظت:
ANTISPAM_JOIN_GAP_MIN=3.0
ANTISPAM_JOIN_GAP_MAX=8.0
# jitter انسانیِ اضافه روی فاصلهٔ join:
ANTISPAM_JOIN_JITTER_MAX=2.5
# سقف هم‌زمانی موج join که پنل ضد اسپم پیشنهاد می‌دهد.
# توجه: این عدد «نرخ» ورود را کنترل نمی‌کند — نرخ را ANTISPAM_JOIN_GAP_MIN/MAX
# کنترل می‌کند. این عدد فقط می‌گوید چند اکانت هم‌زمان اجازهٔ join دارند.
ANTISPAM_MAX_JOIN_CONCURRENCY=2
# کفِ پنجرهٔ join وقتی ضد اسپم فعال است. هر join بین ۳۰ تا ۴۵ ثانیه طول
# می‌کشد و هر شروع ۳ تا ۸ ثانیه بعد از قبلی است، پس پنجرهٔ ۱ عملاً join‌ها را
# سریالی می‌کند بدون اینکه نرخ RPC را پایین‌تر ببرد — فقط ساخت سفارش را چند
# برابر کندتر می‌کند. سقف نهایی همچنان VOICE_JOIN_MAX_CONCURRENCY است.
# مقدار ۱ = رفتار کاملاً سریالیِ قبل.
ANTISPAM_JOIN_WINDOW_FLOOR=4
# pacing خروج از ویس‌کال در پایان/لغو سفارش (ثانیه):
ANTISPAM_LEAVE_GAP_MIN=1.5
ANTISPAM_LEAVE_GAP_MAX=4.0
ANTISPAM_LEAVE_JITTER_MAX=1.2
ANTISPAM_LEAVE_MAX_CONCURRENCY=2
# استراحت هر اکانت بین دو سفارش (دقیقه). 0 = خاموش:
ANTISPAM_ACCOUNT_REST_MINUTES=0

# ── خروج به‌تأخیرافتاده از گروه (دقیقهٔ پایان سفارش فقط از ویس‌کال خارج می‌روند)
GROUP_LEAVE_ENABLED=true
# تأخیر خروج از گروه بعد از پایان سفارش (ساعت) — 168 = یک هفته:
GROUP_LEAVE_DELAY_HOURS=168
# فاصلهٔ زمانی بین خروج دو اکانتِ متوالی — دونه‌به‌دونه و به‌ترتیب (ثانیه):
GROUP_LEAVE_INTERVAL_SEC=60
# حداکثر خروج پردازش‌شده در هر اجرای جاب (هر ۶۰ ثانیه):
GROUP_LEAVE_SWEEP_BATCH=25

# ── ممنوعیت ثبت سفارش جدید پس از لغو (دقیقه) — 0 = خاموش
CANCEL_COOLDOWN_MINUTES=20

# ── حذف تخصیص تکراری اکانت بین سفارش‌های همزمان ────────────────────────────
# یک اکانت تلگرام فقط در یک ویس‌کال می‌تواند باشد و این پروسه به ازای هر
# account_id یک کلاینت و یک انجین نگه می‌دارد (نه به ازای هر سفارش). اگر همهٔ
# اکانت‌های باقی‌ماندهٔ یک سفارش در اختیار سفارش دیگری باشند، به‌جای تحویل
# کوتاه و بی‌صدا، این‌قدر دور منتظر آزاد شدن می‌ماند — و هرگز اکانت را
# نمی‌دزدد. (رویداد ۱۴۰۵/۰۷/۰۴ — سفارش‌های ۸۵۹ و ۸۶۰)
VOICE_STARVED_WAIT_ROUNDS=6
VOICE_STARVED_WAIT_SECONDS=20

# ── خودترمیم نگه‌داشتن‌های محلی (quarantine heal) ──────────────────────────
# اگر قطع‌اتصالِ یکی از اکانت‌ها «تأیید» نشود (معمولاً وسط طوفان تایم‌اوتِ تلگرام)،
# آن اکانت در همین پروسه قفل می‌شود تا کلیدِ سشن دوباره استفاده نشود. این قفل
# همیشگی نیست: جارویِ نگهدار هر چند وقت دوباره تلاشِ قطع‌اتصال می‌کند و اگر
# قطع شدن تأیید شد، اکانت برمی‌گردد. HEAL_SECONDS فاصلهٔ این تلاش‌ها (و مهلت
# تأخیرِ executor روی همان اکانت) است؛ در هر جارو حداکثر MAX_PER_SWEEP اکانت
# بررسی می‌شود تا جارو بلوکه نشود. (حادثة ۱۴۰۵-۰۷-۱۱: ۲۲ از ۴۲ اکانت قفل ماند
# و بیلدِ سفارش ۹۴۱ با live=۰/۲۲ تمام شد.)
VOICE_QUARANTINE_HEAL_SECONDS=180
VOICE_QUARANTINE_HEAL_MAX_PER_SWEEP=6

# وقتی سفارشی هنوز حتی یک اکانت زنده ندارد و همهٔ استخر پیشِ سفارش‌های دیگر
# است، به‌جای ۶ راند، تا این تعداد راند (× VOICE_STARVED_WAIT_SECONDS) برای
# آزادشدن اکانت صبر می‌کند — تحویلِ صفر اکانت بدتر از صبر است، چون زمان
# پولیِ سفارش بعد از پایانِ بیلد شروع می‌شود.
VOICE_STARVED_WAIT_ROUNDS_ZERO_LIVE=45

# ── بازیابی سفارش بعد از ری‌استارت پروسه ────────────────────────────────────
# سفارش‌هایی که موقع OOM-kill / دیپلوی «در حال اجرا» بودند، برای مدت
# باقی‌ماندهٔ پرداخت‌شده دوباره اجرا می‌شوند (زمان ورود مجدد رایگان است) و به
# کاربر اطلاع داده می‌شود. خاموش کردنش رفتار قدیمی را برمی‌گرداند: سفارش تا
# ابد «running» می‌ماند.
ORDER_RECOVERY_ENABLED=true

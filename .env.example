# ═══════════════════════════════════════════════════
# نمونهٔ فایل تنظیمات — این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید:
#   cp .env.example .env
# ⚠️ فایل .env هرگز نباید در گیت commit شود (در .gitignore هست).
# ═══════════════════════════════════════════════════


# ═══════════════════════════════════════════════════
# Telegram API Credentials  (از my.telegram.org و BotFather)
# ═══════════════════════════════════════════════════
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
BOT_TOKEN=


# ═══════════════════════════════════════════════════
# Database Configuration (Docker Network)
# ═══════════════════════════════════════════════════
DATABASE_URL=postgresql://username:password@db:5432/dbname
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname


# ═══════════════════════════════════════════════════
# Redis Cache (Docker Network)
# ═══════════════════════════════════════════════════
REDIS_URL=redis://redis:6379/0


# ═══════════════════════════════════════════════════
# Admin & Security
# ═══════════════════════════════════════════════════
# آیدی عددی ادمین‌ها، با کاما جدا شود
ADMIN_IDS=
# کلید رمزنگاری سشن‌ها (Fernet). برای ساخت:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=


# ═══════════════════════════════════════════════════
# Web Server & Payment Gateway
# ═══════════════════════════════════════════════════
# ⚠️ آدرس عمومیِ callback درگاه پرداخت — باید به سرور خودتان اشاره کند و از
# اینترنت قابل‌دسترس باشد. راهنمای کامل: docs/payment-gateway.fa.md
#
# نکته: این با «زیردامنهٔ اختصاصی زرین‌پال» (CNAME→zpc.zarinpal.com) فرق دارد!
# آن به سرور زرین‌پال می‌رود؛ این باید به سرور خودتان (رکورد A) اشاره کند.
#
# کانتینر nginx (webproxy) درخواست‌ها را روی پورت 80 می‌گیرد و داخلی به
# وب‌سرور می‌رساند؛ پس SERVER_URL بدون :8080 و روی پورت استاندارد 80 است.
#   بدون HTTPS (پورت 80):   SERVER_URL=http://bot.example.com
#   با HTTPS (توصیه‌شده):    SERVER_URL=https://bot.example.com  (نیاز به گواهی روی nginx)
SERVER_URL=http://bot.example.com
# PORT پورت داخلیِ وب‌سرور است (nginx به آن پاس می‌دهد)؛ روی 8080 بماند.
PORT=8080

# شناسهٔ پذیرندهٔ زرین‌پال (بدون آن لینک پرداخت ساخته نمی‌شود)
ZARINPAL_MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# درگاه آقای پرداخت (در صورت استفاده)
AQAYE_PARDAKHT_PIN=sandbox

# پروکسی درخواست‌های درگاه پرداخت (بدون WARP).
# چون ربات با WARP اجرا می‌شود و درگاه‌های ایرانی اتصال از IP خارجی را رد
# می‌کنند، درخواست ساخت/تأیید پرداخت باید از یک پروکسیِ بدون WARP (کانتینر
# payproxy روی IP ایرانیِ هاست) عبور کند. پیش‌فرضِ docker-compose درست است؛
# فقط اگر خواستید غیرفعالش کنید خالی بگذارید (آنگاه از WARP می‌رود و timeout).
PAYMENT_HTTP_PROXY=http://payproxy:8888


# ═══════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════
MAX_ACCOUNTS_PER_USER=1000
RATE_LIMIT_PER_MINUTE=30
# تنها سقف تجاریِ ربات. هر کنترل دیگری (هم‌روندی join، ساخت کلاینت، سقف سقف)
# از روی سخت‌افزار محاسبه می‌شود — بخش «🖥 سقف سخت‌افزار» را ببینید.
MAX_CONCURRENT_ORDERS=5
HEALTH_CHECK_INTERVAL=3600
LOG_LEVEL=INFO


# ═══════════════════════════════════════════════════
# Voice Call Settings
# ═══════════════════════════════════════════════════
JOIN_DELAY_SECONDS=3.0
ACCOUNT_LOCK_TIMEOUT=120
OPERATION_TIMEOUT=90
KEEPALIVE_INTERVAL=20
MAX_JOIN_RETRIES=3
RETRY_BACKOFF_BASE=2.0
# صدای استریم سکوت (بهینه‌شده برای CPU): مونو ۲۴kHz
VOICE_AUDIO_SAMPLE_RATE=24000
VOICE_AUDIO_CHANNELS=1


# ═══════════════════════════════════════════════════
# In-Call Chat (پیام/ری‌اکشن مشتری داخل ویس‌کال)
# ═══════════════════════════════════════════════════
# قابلیتِ ارسال کامنت/ری‌اکشن از چند اکانت درون تماس (نیازمند kurigram که در
# requirements.txt هست). روشن/خاموش کردن این قابلیت از پنل ادمین انجام می‌شود
# (کلید تنظیم: service_incall_chat) و نیازی به متغیر env ندارد.
#
# pacing ضدِ burst: وقتی مشتری از چند اکانت هم‌زمان پیام/ری‌اکشن می‌فرستد،
# درخواست‌ها یک‌جا شلیک نمی‌شوند (که باعث FloodWait و دیده‌نشدن پیام می‌شد)،
# بلکه با فاصلهٔ منظم (~۱ درخواست در ثانیه) و سقف هم‌زمانی محدود ارسال می‌گردند.
# اگر تلگرام FloodWait داد این دو را بزرگ‌تر کنید؛ برای سریع‌تر شدن کوچک‌تر.
INCALL_SEND_STAGGER_MIN=0.8
INCALL_SEND_STAGGER_MAX=1.2
# بیشترین تعداد ارسالِ هم‌زمانِ در حال پرواز (سقف concurrency).
INCALL_SEND_MAX_CONCURRENCY=3

# ── خروج مدیریت‌شده بعد از پایان/لغو سفارش (ضد burst) ──
# اکانت‌ها نباید یک‌جا از ویس‌کال/گروه خارج شوند (ریسک FloodWait و محدودیت).
# فاصله بین شروع هر leave (ثانیه) + سقف هم‌زمانی LeaveGroupCall/leave_chat.
VOICE_LEAVE_STAGGER_MIN=0.8
VOICE_LEAVE_STAGGER_MAX=1.5
VOICE_LEAVE_MAX_CONCURRENCY=2
VOICE_LEAVE_JITTER_MIN=0.0
VOICE_LEAVE_JITTER_MAX=0.4


# ═══════════════════════════════════════════════════
# Delays
# ═══════════════════════════════════════════════════
DELAY_MIN=5


# ═══════════════════════════════════════════════════
# Proxy (SOCKS5 از کانتینر WARP)
# در حالت network_mode: service:warp، پروکسی روی 127.0.0.1:1080 است.
# ═══════════════════════════════════════════════════
USE_PROXY=true
SOCKS5_HOST=127.0.0.1
SOCKS5_PORT=1080
# SOCKS5_USERNAME=
# SOCKS5_PASSWORD=


# ═══════════════════════════════════════════════════
# ایموجی پریمیوم (Custom Emoji) — نیازمند Telegram Premium
# روی اکانتِ «مالکِ ربات» (سازندهٔ ربات در BotFather)
# ═══════════════════════════════════════════════════
# از Bot API 9.4 (۹ فوریهٔ ۲۰۲۶) اگر مالکِ ربات اشتراک پریمیوم داشته باشد،
# ربات می‌تواند در متن پیام‌ها ایموجی سفارشی بفرستد و روی دکمه‌ها
# «آیکون پریمیوم» بگذارد. راهنمای کامل: docs/premium-emoji.fa.md
#
# همهٔ این کلیدها از پنل ادمین → «⚙️ تنظیمات سیستم» → «💎 ایموجی پریمیوم»
# هم قابل تغییرند (تنظیمات پنل بر .env اولویت دارد و در دیتابیس ذخیره می‌شود).
PREMIUM_EMOJI_ENABLED=true
# ایموجی پریمیوم داخل متن پیام‌ها (منوها، گزارش‌ها، پاسخ‌ها، پیام همگانی)
PREMIUM_EMOJI_TEXT=true
# آیکون پریمیوم روی دکمه‌های inline
PREMIUM_EMOJI_BUTTONS=true
# آیکون پریمیوم روی دکمه‌های کیبورد اصلی (reply keyboard)
PREMIUM_EMOJI_REPLY_BUTTONS=true
# ایموجیِ انتهای متن دکمه هم به آیکون تبدیل شود («عضو شدم ✅» → [✅] عضو شدم)
PREMIUM_EMOJI_TRAILING_ICONS=true
# پیام‌های Markdown قدیمی به HTML تبدیل شوند تا ایموجی پریمیوم بگیرند
PREMIUM_EMOJI_MARKDOWN_TO_HTML=true
# اعتبارسنجی شناسه‌ها در استارت (شناسهٔ نامعتبر خودکار حذف می‌شود)
PREMIUM_EMOJI_VALIDATE=true
# در کانال‌ها ایموجی سفارشی مجاز نیست؛ بدون تلاش رد شود
PREMIUM_EMOJI_SKIP_CHANNELS=true
# سقف ایموجی در هر پیام (تلگرام حداکثر ۱۰۰ entity می‌پذیرد)
PREMIUM_EMOJI_MAX_PER_MESSAGE=90

# اگر true باشد، شناسه‌ای که ایموجی واقعی‌اش با ایموجی مورد انتظار بسته فرق
# دارد هم غیرفعال می‌شود (پیش‌فرض false = فقط گزارش در لاگ و پنل ادمین).
PREMIUM_EMOJI_STRICT_MATCH=false
# رنگ‌آمیزی خودکار دکمه‌ها (سبز=تایید/پرداخت، قرمز=حذف/انصراف، آبی=بازگشت/اصلی)
# مبتنی بر Bot API 9.4 — روی همهٔ دکمه‌های inline و reply اعمال می‌شود.
PREMIUM_EMOJI_COLORED_BUTTONS=true
# جایگزینی شناسهٔ ایموجی دلخواه (JSON یا key=id,key=id):
# PREMIUM_EMOJI_OVERRIDES={"rocket":"5389102131527556772"}
PREMIUM_EMOJI_OVERRIDES=

# ═══════════════ 🖥 سقف سخت‌افزار کانتینر ربات ═══════════════
# این دو مقدار در docker-compose.yml مصرف می‌شوند (نه در کد پایتون). بعد از
# تغییرشان باید کانتینر بازسازی شود:
#     docker compose up -d --force-recreate telegram_bot_container
# و بررسی شود:
#     docker inspect telegram_bot_container --format 'Mem={{.HostConfig.Memory}} CPUs={{.HostConfig.NanoCpus}}'
#
# BOT_MEM_LIMIT: رم کانتینر. سرانگشتی ≈ ۳۸ مگابایت به ازای هر اکانتِ داخل
# تماس (۲۶.۳MB پایتونِ اندازه‌گیری‌شده + ~۱۲MB پروسهٔ ffmpeg) + ۱ گیگابایت
# سهم ثابت. یعنی 6G ≈ ۱۳۵ اکانت همزمان، 3G ≈ ۵۴ اکانت. کمتر از 3G نگذارید.
BOT_MEM_LIMIT=6G
#
# BOT_CPU_LIMIT: تعداد هستهٔ اختصاصی ربات. ⚠️ پیش‌فرض قدیمی 2.0 بود، یعنی روی
# هاست ۸ هسته‌ای ربات هرگز بیش از ۲۵٪ ماشین را نمی‌دید و همین گلوگاه اصلی بود.
# 8.0 = همهٔ هسته‌ها. اگر warp/postgres هم روی همین هاست هستند 6.0–7.0 امن‌تر
# است، چون warp تمام مدیای WebRTC را تونل می‌زند.
BOT_CPU_LIMIT=8.0
#
# ── کارهایی که با هستهٔ بیشتر واقعاً سریع‌تر می‌شوند ──────────────────────
# مسیر مدیا اصلاً از پایتون رد نمی‌شود، پس با هسته مقیاس می‌شود:
#   • ffmpeg برای هر اکانت یک «پروسهٔ جدا» است (-threads 1) → موازی روی هسته‌ها
#   • ntgcalls یک .so بومی (Rust) است؛ MediaSource.FFMPEG را می‌گیرد و خواندن
#     فریم‌ها و رمزارزی/انتقال WebRTC را خودش انجام می‌دهد
#   • رمزنگاری MTProto با tgcrypto (اکستنشن C) انجام می‌شود، نه پایتون
# آنچه به GIL می‌ماند فقط «هماهنگ‌سازی» است: پمپ‌های sessionِ Pyrogram،
# توزیع رویدادها و مانیتورهای keepalive — که عمدتاً I/O-bound هستند.
#
# ── هم‌روندیِ خودکار (معمولاً دست نزنید) ─────────────────────────────────
# اگر این سه را «خالی/حذف» بگذارید، از روی سهمیهٔ واقعی CPU کانتینر حساب
# می‌شوند. اگر عدد بگذارید، همان عدد برنده است. مقادیر روی هاست ۸ هسته‌ای:
#   GLOBAL_JOIN_CONCURRENCY   = 64  (۸×هسته، کف ۸، سقف ۹۶)
#   CLIENT_CREATE_CONCURRENCY = 16  (۲×هسته، کف ۴، سقف ۱۶)
#   VOICE_JOIN_MAX_CONCURRENCY= 16  (۲×هسته، کف ۲، سقف ۱۶)
# ⚠️ سقف‌ها عمدی‌اند: FloodWait تلگرام یک محدودیت سمتِ سرور است و با سخت‌افزار
# بیشتر برداشته نمی‌شود. سقف را با دست بالا نبرید مگر اینکه لاگ FloodWait
# نبینید.
#GLOBAL_JOIN_CONCURRENCY=
#CLIENT_CREATE_CONCURRENCY=
#VOICE_JOIN_MAX_CONCURRENCY=
#
# ⚠️ مهم: بالا بردن سخت‌افزار به‌تنهایی ظرفیت فروش را زیاد نمی‌کند. گارد ظرفیت
# (پایین) دو منبع را مدل می‌کند: «تعداد اکانت‌های سالم پول» و
# MAX_CONCURRENT_ORDERS. اگر پول شما ۴۲ اکانت است، با ۱۶ گیگ رم و ۸ هسته هم
# همان ۴۲ اکانت قابل فروش است — سقف فیزیکی، تعداد اکانت‌هاست.

# ═══════════════ 🛡 گارد ظرفیت منابع (Capacity Guard) ═══════════════
# قبل از ثبت هر سفارش (آنی و زمان‌بندی) مصرف منابع در «کل بازهٔ اجرای سفارش»
# سنجیده می‌شود؛ اگر ظرفیت کافی نباشد سفارش پذیرفته نمی‌شود و دقیق‌ترین
# بازهٔ آزاد به کاربر پیشنهاد (و قابل رزرو) می‌گردد.
# فعال/غیرفعال کردن گارد:
CAPACITY_GUARD_ENABLED=true
# حاشیهٔ ایمن از کل اکانت‌های سالم (درصد). مثلاً 10 یعنی فقط 90% پول قابل
# رزرو است تا سفارش‌های در حال اجرا حاشیهٔ تنفس داشته باشند.
CAPACITY_SAFETY_BUFFER_PERCENT=10

# ── گارد حافظهٔ cgroup (جلوگیری از OOM-kill وسط تماس) ──────────────────
# کرنل کانتینر را با SIGKILL می‌کشد وقتی مصرف cgroup از سقف RAM رد شود؛ آن
# وقت همهٔ تماس‌های فعال یک‌جا می‌میرند (dmesg: «Memory cgroup out of memory»).
# اگر مصرف از این درصدِ سقف بیشتر باشد، سفارش جدید پذیرفته نمی‌شود.
# توجه: rss_mb پایتون این عدد نیست؛ ffmpeg هر اکانت و حافظهٔ کرنل/سوکتِ
# WebRTC هم در cgroup حساب می‌شوند.
MEMORY_GUARD_ENABLED=true
MEMORY_GUARD_MAX_PERCENT=85

# ── بازیابی سفارش بعد از ری‌استارت / گرسنگی اکانت ───────────────────────
# بعد از کرش/OOM/دیپلوی، سفارش‌های `running` برای مدتِ باقی‌مانده از سر
# گرفته می‌شوند (نه اینکه بی‌صدا stopped شوند).
ORDER_RECOVERY_ENABLED=true
# اگر همهٔ اکانت‌های باقی‌مانده درگیر سفارش دیگری باشند، چند دور و هر دور
# چند ثانیه منتظر آزاد شدن بمان (به‌جای دزدیدن اکانت یا تحویل سفارش ناقص).
VOICE_STARVED_WAIT_ROUNDS=6
VOICE_STARVED_WAIT_SECONDS=20
# سفارش‌های «تکمیل و خروج» (بدون مدت) در تایم‌لاین ظرفیت با این تخمین (دقیقه)
# لحاظ می‌شوند:
CAPACITY_UNKNOWN_DURATION_MINUTES=60
# دقت جست‌وجوی «اولین بازهٔ آزاد» برای پیشنهاد به کاربر (دقیقه):
CAPACITY_STEP_MINUTES=5
# افق جست‌وجوی پیشنهاد (ساعت):
CAPACITY_HORIZON_HOURS=24
